# Copy to .env and fill in your OpenRouter key.
#   cp .env.example .env

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# The accounting system supplied with the assignment.
ACCOUNTING_API_BASE=http://localhost:8080
ACCOUNTING_API_KEY=demo-key-1234

# --- optional: the automation / human-review boundary ------------------------
# Which model reads the invoices.
EXTRACTION_MODEL=google/gemini-3.7-flash
# Register clean invoices without asking. Set false to route everything to review.
AUTO_POST_ENABLED=true
# Invoices above this total always get a human, however clean the extraction.
# Set to 0 to disable.
AMOUNT_REVIEW_THRESHOLD_JPY=1000000
# Process the 12 sample invoices automatically on first boot. Off by default so
# the app opens on an empty upload screen; there is a button to load them.
SEED_ON_STARTUP=false
